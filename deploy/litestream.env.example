# Copy to .env.litestream (ignored by Git) and fill in your own settings.
OFFICE_LITESTREAM_ENABLED=true
OFFICE_DATABASE_PATH=/data/office-office.sqlite3
OFFICE_BACKUP_BUCKET=your-private-bucket
OFFICE_BACKUP_PREFIX=office-office/production
AWS_REGION=your-bucket-region

# Omit these only when using another supported AWS SDK credential provider.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# AWS_SESSION_TOKEN=optional-for-temporary-credentials
# AWS_ENDPOINT_URL_S3=https://your-s3-compatible-endpoint.example

# First boot into a NEW EMPTY backup location only. Remove after first startup.
# Never allows a fresh office after an authentication/network/restore error.
# OFFICE_ALLOW_NEW_DATABASE=true
