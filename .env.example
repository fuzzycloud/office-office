# Export overrides in your shell; .env is not loaded automatically.
ADDR=127.0.0.1:8080
OFFICE_DATABASE_PATH=data/office-office.sqlite3

# Temporary in-memory storage for tests; preselects sample data on registration.
# OFFICE_DEMO_MODE=true
# Non-loopback networking acknowledgement; use a private ingress during bootstrap.
# OFFICE_ALLOW_REMOTE=true

# Optional Litestream replication (bundled in the container, disabled by default).
# Set true only with a durable database and a private bucket. Keep a unique backup prefix.
# OFFICE_LITESTREAM_ENABLED=true
# OFFICE_BACKUP_BUCKET=your-private-bucket
# OFFICE_BACKUP_PREFIX=office-office/backups
# AWS_REGION=your-bucket-region
# First boot with an empty backup location only; remove after initialization.
# OFFICE_ALLOW_NEW_DATABASE=true

# Credentials are supplied to the runtime only, never committed in this file or image.
# Litestream supports workload roles; the current file client requires environment credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Optional S3-compatible endpoint:
# AWS_ENDPOINT_URL_S3=https://your-s3-compatible-endpoint.example

# Optional private file storage. Keep this prefix separate from database backups;
# the seven-day Litestream recovery window must not expire uploaded files.
# OFFICE_FILES_BUCKET=your-private-bucket
# OFFICE_FILES_PREFIX=office-office/files
# Uses the same AWS runtime credentials/region above.
