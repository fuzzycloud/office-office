# UI preview starts without credentials or cloud settings.
# Export overrides in your shell; .env is not loaded automatically.
ADDR=127.0.0.1:8080

# Reserved for the durable SQLite + Litestream phase (not used by this preview).
# Prefer an AWS workload role over long-lived keys on a hosted server.
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# OFFICE_BACKUP_BUCKET=
# OFFICE_BACKUP_PREFIX=office-office
